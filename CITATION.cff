    given-names: Maciej
  - family-names: Pliszka
    given-names: Mateusz
  - family-names: Janisiów
    given-names: Łukasz
keywords:
  - pubmed
  - bibliometrics
  - nlp
  - named-entity-recognition
  - topic-modeling
  - co-authorship-network
license: MIT
repository-code: "https://github.com/MPKuchciak/biomedical-literature-analysis"
date-released: 2026-01-01